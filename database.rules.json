{
  "rules": {
    "likes": {
      ".read": true,
      "$trip": {
        ".write": "$trip.matches(/^t[0-9]+$/) && newData.exists()",
        ".validate": "newData.isNumber() && newData.val() >= 0 && ((!data.exists() && newData.val() == 1) || (data.exists() && (newData.val() == data.val() + 1 || newData.val() == data.val() - 1)))"
      }
    },
    "wantBy": {
      ".read": true,
      "$trip": {
        "$food": {
          "$name": {
            ".write": "$trip.matches(/^[a-z0-9-]+$/) && $food.matches(/^d[0-9]+f[0-9]+$/) && $name.length >= 1 && $name.length <= 20",
            ".validate": "newData.val() == true"
          }
        }
      }
    }
  }
}
